# Credenciales de Binance (requeridas solo si DRY_RUN=false)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Modo simulación (true = solo loguea oportunidades, no opera)
DRY_RUN=true

# Comisión promedio por pata. Ej: 0.00025 = 0.025% promedio si dos pares FDUSD
# tienen 0% de comisión y el restante (ETHBTC) tiene 0.075%.
FEE_RATE=0.00025

# Profit neto mínimo post-fees para operar (%)
MIN_PROFIT_PCT=0.05

# Monto por ciclo de arbitraje en BTC
TRADE_AMOUNT=0.002

# Frescura máxima de los precios para evaluar (ms)
MAX_PRICE_AGE_MS=1500

# Espera mínima entre ejecuciones (segundos)
COOLDOWN_S=5

# Intervalo entre resúmenes de proximidad (segundos)
STATS_INTERVAL_S=60

# Pares del triángulo en orden (separados por coma)
# Usa pares con FDUSD (ej. BTCFDUSD,ETHFDUSD,ETHBTC) para aprovechar 0% de comisión en fiat.
PAIRS=BTCFDUSD,ETHFDUSD,ETHBTC
