# Credenciales de Binance (requeridas solo si DRY_RUN=false)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Modo simulación (true = solo loguea oportunidades, no opera)
DRY_RUN=true

# Comisión taker por pata. El bot usa LIMIT FOK al top-of-book, que siempre
# llena como taker (las promos 0% de FDUSD son solo maker). Con BNB: 0.00075;
# sin BNB: 0.001. Total del ciclo = 3 patas.
FEE_RATE=0.00075

# Profit neto mínimo post-fees para operar (%)
MIN_PROFIT_PCT=0.05

# Monto por ciclo de arbitraje en BTC
TRADE_AMOUNT=0.002

# Frescura máxima de los precios para evaluar (ms)
MAX_PRICE_AGE_MS=1500

# Espera mínima entre ejecuciones (segundos)
COOLDOWN_S=5

# Pares del triángulo en orden (separados por coma)
# Usa pares con FDUSD (ej. BTCFDUSD,ETHFDUSD,ETHBTC) por su maker 0%.
PAIRS=BTCFDUSD,ETHFDUSD,ETHBTC
